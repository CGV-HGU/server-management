#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${LAB_MANAGE_CONFIG_FILE:-/etc/default/lab-manage}"
RUNTIME_CONFIG_VARS=(
    LAB_MANAGE_DATA_DIR
    LAB_MANAGE_SHARED_DIR
    LAB_MANAGE_PRIVATE_DIR
    LAB_MANAGE_HOME_BASE_DIR
    LAB_MANAGE_LABGROUP
    LAB_MANAGE_TEAMGROUP
    LAB_MANAGE_CONFIG_DIR
    LAB_MANAGE_SHARED_BASHRC_FILE
    LAB_MANAGE_BASHRC_DEFAULTS_FILE
    LAB_MANAGE_METADATA_DIR
    LAB_MANAGE_TEAM_SOURCES_FILE
    LAB_MANAGE_SYNC_LOCK_DIR
)
RUNTIME_ENV_NAMES=()
RUNTIME_ENV_VALUES=()
for runtime_var in "${RUNTIME_CONFIG_VARS[@]}"; do
    if [[ ${!runtime_var+x} ]]; then
        RUNTIME_ENV_NAMES+=("$runtime_var")
        RUNTIME_ENV_VALUES+=("${!runtime_var}")
    fi
done

if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi
for runtime_var_idx in "${!RUNTIME_ENV_NAMES[@]}"; do
    printf -v "${RUNTIME_ENV_NAMES[$runtime_var_idx]}" '%s' "${RUNTIME_ENV_VALUES[$runtime_var_idx]}"
done
unset runtime_var runtime_var_idx

DATA_DIR="${LAB_MANAGE_DATA_DIR:-/data}"
SHARED_DIR="${LAB_MANAGE_SHARED_DIR:-${DATA_DIR}/shared}"
PRIVATE_DIR="${LAB_MANAGE_PRIVATE_DIR:-${DATA_DIR}/private}"
HOME_BASE_DIR="${LAB_MANAGE_HOME_BASE_DIR:-/home}"
LABGROUP="${LAB_MANAGE_LABGROUP:-labusers}"
TEAMGROUP="${LAB_MANAGE_TEAMGROUP:-labteams}"
CONFIG_DIR="${LAB_MANAGE_CONFIG_DIR:-${DATA_DIR}/config}"
SHARED_BASHRC_FILE="${LAB_MANAGE_SHARED_BASHRC_FILE:-${LAB_MANAGE_BASHRC_DEFAULTS_FILE:-${CONFIG_DIR}/shared_bashrc}}"
TEAM_METADATA_DIR="${LAB_MANAGE_METADATA_DIR:-/etc/lab-manage}"
TEAM_SOURCES_FILE="${LAB_MANAGE_TEAM_SOURCES_FILE:-${TEAM_METADATA_DIR}/team-sources}"
SYNC_LOCK_DIR="${LAB_MANAGE_SYNC_LOCK_DIR:-${TEAM_METADATA_DIR}/sync.lock}"
BASHRC_MANAGED_BEGIN="# >>> lab-manage defaults >>>"
BASHRC_MANAGED_END="# <<< lab-manage defaults <<<"

log_info() {
    echo -e "\033[0;34m[INFO]\033[0m $*" >&2
}

log_warn() {
    echo -e "\033[0;33m[WARN]\033[0m $*" >&2
}

log_error() {
    echo -e "\033[0;31m[ERROR]\033[0m $*" >&2
}

log_success() {
    echo -e "\033[0;32m[OK]\033[0m $*" >&2
}

user_home_dir() {
    printf '%s/%s\n' "$HOME_BASE_DIR" "$1"
}

shell_quote() {
    printf '%q' "$1"
}

check_root() {
    if [[ "${LAB_MANAGE_TEST_SKIP_ROOT:-0}" == "1" ]]; then
        return 0
    fi

    if [[ $EUID -ne 0 ]]; then
        log_error "Must be run as root"
        exit 1
    fi
}

ensure_group() {
    local group_name="$1"

    if ! getent group "$group_name" &>/dev/null; then
        log_info "Creating $group_name group"
        groupadd "$group_name"
    fi
}

ensure_groups() {
    if ! getent group docker &>/dev/null; then
        log_error "docker group does not exist"
        exit 1
    fi

    ensure_group "$LABGROUP"
    ensure_group "$TEAMGROUP"
}

ensure_shared_dir() {
    mkdir -p "$SHARED_DIR"
    chmod 777 "$SHARED_DIR"

    if [[ "${LAB_MANAGE_TEST_SKIP_ROOT:-0}" != "1" && $EUID -eq 0 ]]; then
        chown root:root "$SHARED_DIR" 2>/dev/null || true
    fi
}

ensure_metadata_storage() {
    mkdir -p "$TEAM_METADATA_DIR"
    chmod 700 "$TEAM_METADATA_DIR"

    if [[ "${LAB_MANAGE_TEST_SKIP_ROOT:-0}" != "1" && $EUID -eq 0 ]]; then
        chown root:root "$TEAM_METADATA_DIR"
    fi

    if [[ ! -f "$TEAM_SOURCES_FILE" ]]; then
        : > "$TEAM_SOURCES_FILE"
    fi

    chmod 600 "$TEAM_SOURCES_FILE"

    if [[ "${LAB_MANAGE_TEST_SKIP_ROOT:-0}" != "1" && $EUID -eq 0 ]]; then
        chown root:root "$TEAM_SOURCES_FILE"
    fi
}

username_normalize() {
    echo "$1" | tr '[:upper:]' '[:lower:]'
}

validate_username() {
    local username="$1"

    if [[ "$username" =~ ^- ]]; then
        log_error "Username '$username' cannot start with a hyphen"
        return 1
    fi

    if [[ "$username" =~ ^[0-9] ]]; then
        log_error "Username '$username' cannot start with a digit"
        return 1
    fi

    if [[ "$username" =~ \. ]]; then
        log_error "Username '$username' cannot contain a period"
        return 1
    fi

    if [[ ${#username} -gt 32 ]]; then
        log_error "Username '$username' exceeds 32 characters"
        return 1
    fi

    if [[ ! "$username" =~ ^[a-z0-9_-]+$ ]]; then
        log_error "Username '$username' contains invalid characters (only a-z, 0-9, _, - allowed)"
        return 1
    fi

    return 0
}

user_in_group() {
    local username="$1"
    local group_name="$2"

    id -nG "$username" 2>/dev/null | tr ' ' '\n' | grep -Fxq "$group_name"
}

get_group_members() {
    local group_name="$1"
    local members

    members=$(getent group "$group_name" 2>/dev/null | cut -d: -f4)
    printf '%s\n' "$members"
}

fetch_github_keys() {
    local username="$1"
    curl -fsSL --proto '=https' --max-time 10 "https://github.com/${username}.keys"
}

validate_ssh_keys() {
    local keys="${1:-$(cat)}"
    local valid_keys=""
    local invalid_count=0
    local valid_count=0

    while IFS= read -r line; do
        [[ -z "$line" ]] && continue

        if [[ "$line" =~ ^(ssh-rsa\ |ssh-ed25519\ |ecdsa-sha2-|sk-ssh-ed25519@|sk-ecdsa-sha2-) ]]; then
            valid_keys+="${line}"$'\n'
            ((valid_count++)) || true
        else
            ((invalid_count++)) || true
        fi
    done <<< "$keys"

    if [[ $invalid_count -gt 0 ]]; then
        log_warn "Filtered out $invalid_count invalid SSH key line(s)"
    fi

    if [[ $valid_count -eq 0 ]]; then
        return 1
    fi

    printf '%s' "$valid_keys"
    return 0
}

normalize_source_users() {
    local raw_sources="$1"
    local entry
    local normalized
    local output=()
    local seen_list=""

    IFS=',' read -r -a source_array <<< "$raw_sources"
    for entry in "${source_array[@]}"; do
        [[ -z "$entry" ]] && continue
        normalized=$(username_normalize "$entry")
        validate_username "$normalized" || return 1

        if printf '%s\n' "$seen_list" | grep -Fxq "$normalized"; then
            log_error "Duplicate source user '$normalized' is not allowed"
            return 1
        fi

        seen_list+="${normalized}"$'\n'
        output+=("$normalized")
    done

    if [[ ${#output[@]} -eq 0 ]]; then
        log_error "At least one source user is required"
        return 1
    fi

    local joined=""
    local idx
    for idx in "${!output[@]}"; do
        if [[ $idx -gt 0 ]]; then
            joined+=","
        fi
        joined+="${output[$idx]}"
    done

    printf '%s\n' "$joined"
}

validate_team_sources() {
    local team_name="$1"
    local source_csv="$2"
    local source_user

    IFS=',' read -r -a source_array <<< "$source_csv"
    for source_user in "${source_array[@]}"; do
        validate_username "$source_user" || return 1
    done
}

team_sources_for_account() {
    local team_name="$1"

    ensure_metadata_storage

    while IFS=$'\t' read -r existing_team existing_sources; do
        [[ -z "${existing_team:-}" ]] && continue
        [[ "$existing_team" =~ ^# ]] && continue

        if [[ "$existing_team" == "$team_name" ]]; then
            printf '%s\n' "$existing_sources"
            return 0
        fi
    done < "$TEAM_SOURCES_FILE"

    return 1
}

save_team_sources() {
    local team_name="$1"
    local source_csv="$2"
    local temp_file
    local found=0
    local existing_team
    local existing_sources

    ensure_metadata_storage
    temp_file=$(mktemp "${TEAM_METADATA_DIR}/team-sources.XXXXXX")

    while IFS=$'\t' read -r existing_team existing_sources; do
        [[ -z "${existing_team:-}" ]] && continue
        [[ "$existing_team" =~ ^# ]] && continue

        if [[ "$existing_team" == "$team_name" ]]; then
            if [[ "$existing_sources" != "$source_csv" ]]; then
                rm -f "$temp_file"
                log_error "Team account '$team_name' already has different source users configured"
                return 1
            fi
            printf '%s\t%s\n' "$team_name" "$source_csv" >> "$temp_file"
            found=1
        else
            printf '%s\t%s\n' "$existing_team" "$existing_sources" >> "$temp_file"
        fi
    done < "$TEAM_SOURCES_FILE"

    if [[ $found -eq 0 ]]; then
        printf '%s\t%s\n' "$team_name" "$source_csv" >> "$temp_file"
    fi

    chmod 600 "$temp_file"
    mv -f "$temp_file" "$TEAM_SOURCES_FILE"
}

remove_team_sources() {
    local team_name="$1"
    local temp_file
    local existing_team
    local existing_sources

    ensure_metadata_storage
    temp_file=$(mktemp "${TEAM_METADATA_DIR}/team-sources.XXXXXX")

    while IFS=$'\t' read -r existing_team existing_sources; do
        [[ -z "${existing_team:-}" ]] && continue
        [[ "$existing_team" =~ ^# ]] && continue
        [[ "$existing_team" == "$team_name" ]] && continue

        printf '%s\t%s\n' "$existing_team" "$existing_sources" >> "$temp_file"
    done < "$TEAM_SOURCES_FILE"

    chmod 600 "$temp_file"
    mv -f "$temp_file" "$TEAM_SOURCES_FILE"
}

update_team_sources() {
    local team_name="$1"
    local source_csv="$2"
    local temp_file
    local found=0

    ensure_metadata_storage
    temp_file=$(mktemp "${TEAM_METADATA_DIR}/team-sources.XXXXXX")

    while IFS=$'\t' read -r existing_team existing_sources; do
        [[ -z "${existing_team:-}" ]] && continue
        [[ "$existing_team" =~ ^# ]] && continue

        if [[ "$existing_team" == "$team_name" ]]; then
            printf '%s\t%s\n' "$team_name" "$source_csv" >> "$temp_file"
            found=1
        else
            printf '%s\t%s\n' "$existing_team" "$existing_sources" >> "$temp_file"
        fi
    done < "$TEAM_SOURCES_FILE"

    if [[ $found -eq 0 ]]; then
        rm -f "$temp_file"
        log_error "Team account '$team_name' not found in metadata"
        return 1
    fi

    chmod 600 "$temp_file"
    mv -f "$temp_file" "$TEAM_SOURCES_FILE"
}

team_references_user() {
    local username="$1"
    local references=()
    local team_name
    local source_csv
    local source_user

    ensure_metadata_storage

    while IFS=$'\t' read -r team_name source_csv; do
        [[ -z "${team_name:-}" ]] && continue
        [[ "$team_name" =~ ^# ]] && continue

        IFS=',' read -r -a source_array <<< "$source_csv"
        for source_user in "${source_array[@]}"; do
            if [[ "$source_user" == "$username" ]]; then
                references+=("$team_name")
                break
            fi
        done
    done < "$TEAM_SOURCES_FILE"

    if [[ ${#references[@]} -eq 0 ]]; then
        return 1
    fi

    local joined=""
    local idx
    for idx in "${!references[@]}"; do
        if [[ $idx -gt 0 ]]; then
            joined+=","
        fi
        joined+="${references[$idx]}"
    done

    printf '%s\n' "$joined"
}

merge_source_user_keys() {
    local source_csv="$1"
    local source_user
    local raw_keys
    local valid_keys
    local line
    local merged=""
    local count=0
    local seen_lines=""

    IFS=',' read -r -a source_array <<< "$source_csv"
    for source_user in "${source_array[@]}"; do
        if ! raw_keys=$(fetch_github_keys "$source_user"); then
            log_warn "Could not fetch GitHub SSH keys for source user '$source_user'"
            continue
        fi

        if ! valid_keys=$(validate_ssh_keys "$raw_keys"); then
            log_warn "No valid GitHub SSH keys found for source user '$source_user'"
            continue
        fi

        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            if ! printf '%s' "$seen_lines" | grep -Fqx "$line"; then
                seen_lines+="${line}"$'\n'
                merged+="${line}"$'\n'
                ((count++)) || true
            fi
        done <<< "$valid_keys"
    done

    if [[ $count -eq 0 ]]; then
        return 1
    fi

    printf '%s' "$merged"
}

team_account_has_metadata() {
    local team_name="$1"
    team_sources_for_account "$team_name" >/dev/null 2>&1
}

team_account_is_system_user() {
    local team_name="$1"

    id "$team_name" &>/dev/null && user_in_group "$team_name" "$TEAMGROUP"
}

rollback_team_account_creation() {
    local team_name="$1"
    local had_error=0

    if team_account_has_metadata "$team_name"; then
        if ! remove_team_sources "$team_name"; then
            log_error "Rollback could not remove metadata for '$team_name'"
            had_error=1
        fi
    fi

    cleanup_storage "$team_name"

    if id "$team_name" &>/dev/null; then
        if ! userdel -r "$team_name" &>/dev/null; then
            log_error "Rollback could not remove system user '$team_name'"
            had_error=1
        fi
    fi

    return "$had_error"
}

STATE_LOCK_HELD=0

acquire_state_lock() {
    local attempts=0

    ensure_metadata_storage
    while ! mkdir "$SYNC_LOCK_DIR" 2>/dev/null; do
        ((attempts++)) || true
        if [[ $attempts -ge 50 ]]; then
            return 1
        fi
        sleep 0.1
    done

    STATE_LOCK_HELD=1
}

release_state_lock() {
    if [[ $STATE_LOCK_HELD -eq 1 ]]; then
        rmdir "$SYNC_LOCK_DIR" 2>/dev/null || true
        STATE_LOCK_HELD=0
    fi
}

enable_state_lock_trap() {
    trap 'release_state_lock' EXIT INT TERM
}

disable_state_lock_trap() {
    trap - EXIT INT TERM
}

ensure_user_ssh_dir() {
    local username="$1"
    local ssh_dir

    ssh_dir="$(user_home_dir "$username")/.ssh"

    mkdir -p "$ssh_dir"
    chmod 700 "$ssh_dir"
    chown -R "${username}:${username}" "$ssh_dir" 2>/dev/null || true
    printf '%s\n' "$ssh_dir"
}

write_authorized_keys() {
    local username="$1"
    local keys="$2"
    local ssh_dir
    local auth_file
    local current_keys=""
    local temp_file

    ssh_dir=$(ensure_user_ssh_dir "$username")
    auth_file="${ssh_dir}/authorized_keys"

    if [[ -f "$auth_file" ]]; then
        current_keys=$(<"$auth_file")
        if [[ "$current_keys" == "$keys" ]]; then
            return 10
        fi
    fi

    temp_file=$(mktemp "${ssh_dir}/authorized_keys.XXXXXX")
    printf '%s' "$keys" > "$temp_file"
    chmod 600 "$temp_file"
    chown "${username}:${username}" "$temp_file" 2>/dev/null || true
    mv -f "$temp_file" "$auth_file"
    chown -R "${username}:${username}" "$ssh_dir" 2>/dev/null || true
    return 0
}

create_system_user() {
    local username="$1"
    local groups="$2"

    useradd --create-home --shell /bin/bash "$username"
    passwd -l "$username"
    usermod -aG "$groups" "$username"
}

setup_storage() {
    local username="$1"
    local home_dir

    home_dir=$(user_home_dir "$username")

    mkdir -p "${PRIVATE_DIR}/${username}"
    chown "${username}:${username}" "${PRIVATE_DIR}/${username}" 2>/dev/null || true
    chmod 700 "${PRIVATE_DIR}/${username}"

    ln -sf "${SHARED_DIR}" "${home_dir}/shared"
    ln -sf "${PRIVATE_DIR}/${username}" "${home_dir}/private"

    chown -h "${username}:${username}" "${home_dir}/shared" "${home_dir}/private" 2>/dev/null || true
}

render_bashrc_defaults() {
    local shared_bashrc

    shared_bashrc=$(shell_quote "$SHARED_BASHRC_FILE")

    cat <<EOF
# Load lab-wide shell defaults managed outside user homes.
if [[ -f $shared_bashrc ]]; then
    source $shared_bashrc
fi
EOF
}

ensure_bashrc_defaults() {
    local username="$1"
    local home_dir
    local bashrc
    local temp_file

    if [[ "${LAB_MANAGE_SKIP_BASHRC_DEFAULTS:-0}" == "1" ]]; then
        return 0
    fi

    home_dir=$(user_home_dir "$username")
    bashrc="${home_dir}/.bashrc"

    touch "$bashrc"
    temp_file=$(mktemp "${home_dir}/.bashrc.XXXXXX")

    awk -v begin="$BASHRC_MANAGED_BEGIN" -v end="$BASHRC_MANAGED_END" '
        $0 == begin { in_block=1; next }
        $0 == end { in_block=0; next }
        !in_block { print }
    ' "$bashrc" > "$temp_file"

    {
        printf '\n%s\n' "$BASHRC_MANAGED_BEGIN"
        if ! render_bashrc_defaults; then
            rm -f "$temp_file"
            return 1
        fi
        printf '%s\n' "$BASHRC_MANAGED_END"
    } >> "$temp_file"

    chmod 644 "$temp_file"
    chown "${username}:${username}" "$temp_file" 2>/dev/null || true
    mv -f "$temp_file" "$bashrc"
    chown "${username}:${username}" "$bashrc" 2>/dev/null || true
}

cleanup_storage() {
    local username="$1"

    if [[ -d "${PRIVATE_DIR}/${username}" ]]; then
        rm -rf "${PRIVATE_DIR:?}/${username:?}"
        log_info "Removed private storage for '$username'"
    fi
}

personal_add_usage() {
    echo "Usage: lab-manage add <username> [...]" >&2
}

team_add_usage() {
    echo "Usage: lab-manage add --team <account> --from <user1,user2>" >&2
}

update_usage() {
    cat <<EOF >&2
Usage: lab-manage update --team <account> --from <user1,user2,...>
       lab-manage update --team <account> --add <user1,user2,...>
       lab-manage update --team <account> --remove <user1,user2,...>
EOF
}

append_unique_user() {
    local username="$1"
    local existing_user

    for existing_user in "${refresh_users[@]}"; do
        if [[ "$existing_user" == "$username" ]]; then
            return 0
        fi
    done

    refresh_users+=("$username")
}

add_personal_users() {
    local username
    local normalized
    local keys
    local valid_keys

    for username in "$@"; do
        normalized=$(username_normalize "$username")

        validate_username "$normalized" || continue

        if id "$normalized" &>/dev/null; then
            log_warn "User '$normalized' already exists, skipping"
            continue
        fi

        log_info "Creating user '$normalized'"

        keys=""
        valid_keys=""
        if keys=$(fetch_github_keys "$normalized"); then
            if valid_keys=$(validate_ssh_keys "$keys"); then
                log_info "Fetched SSH keys for '$normalized'"
            else
                log_warn "No valid SSH keys found for '$normalized', creating user without keys"
            fi
        else
            log_warn "Could not fetch SSH keys for '$normalized', creating user without keys"
        fi

        create_system_user "$normalized" "docker,${LABGROUP}"
        ensure_user_ssh_dir "$normalized" >/dev/null

        if [[ -n "$valid_keys" ]]; then
            write_authorized_keys "$normalized" "$valid_keys" >/dev/null || true
        fi

        setup_storage "$normalized"
        ensure_bashrc_defaults "$normalized"
        log_success "User '$normalized' created successfully"
    done
}

add_team_account() {
    local team_name="$1"
    local raw_sources="$2"
    local normalized_team
    local normalized_sources
    local merged_keys

    rollback_or_fail() {
        local rollback_message="$1"

        if ! rollback_team_account_creation "$normalized_team"; then
            log_error "$rollback_message"
        fi
    }

    normalized_team=$(username_normalize "$team_name")
    validate_username "$normalized_team" || return 1

    normalized_sources=$(normalize_source_users "$raw_sources") || return 1
    validate_team_sources "$normalized_team" "$normalized_sources" || return 1

    if ! merged_keys=$(merge_source_user_keys "$normalized_sources"); then
        log_error "No valid GitHub SSH keys available from selected source users for '$normalized_team'"
        return 1
    fi

    if ! acquire_state_lock; then
        log_error "Could not acquire state lock"
        return 1
    fi
    enable_state_lock_trap

    local existing_sources=""
    if existing_sources=$(team_sources_for_account "$normalized_team"); then
        if [[ "$existing_sources" != "$normalized_sources" ]]; then
            release_state_lock
            disable_state_lock_trap
            log_error "Team account '$normalized_team' already exists with different source users: $existing_sources"
            return 1
        fi

        if ! team_account_is_system_user "$normalized_team"; then
            release_state_lock
            disable_state_lock_trap
            log_error "Team account '$normalized_team' has metadata but is missing the managed system account state"
            return 1
        fi

        release_state_lock
        disable_state_lock_trap
        log_warn "Team account '$normalized_team' already exists, skipping"
        return 0
    fi

    if id "$normalized_team" &>/dev/null; then
        release_state_lock
        disable_state_lock_trap
        log_error "User '$normalized_team' already exists but is not a managed team account; refusing to reuse it"
        return 1
    fi

    log_info "Creating team account '$normalized_team' from GitHub source users '$normalized_sources'"

    if ! create_system_user "$normalized_team" "docker,${TEAMGROUP}"; then
        rollback_or_fail "Rollback left partial state for '$normalized_team' after create_system_user failure"
        release_state_lock
        disable_state_lock_trap
        log_error "Failed to create team account '$normalized_team'"
        return 1
    fi

    if ! ensure_user_ssh_dir "$normalized_team" >/dev/null; then
        rollback_or_fail "Rollback left partial state for '$normalized_team' after SSH directory setup failure"
        release_state_lock
        disable_state_lock_trap
        log_error "Failed to initialize SSH directory for '$normalized_team'"
        return 1
    fi

    if ! write_authorized_keys "$normalized_team" "$merged_keys" >/dev/null; then
        rollback_or_fail "Rollback left partial state for '$normalized_team' after authorized_keys write failure"
        release_state_lock
        disable_state_lock_trap
        log_error "Failed to write authorized_keys for '$normalized_team'"
        return 1
    fi

    if ! setup_storage "$normalized_team"; then
        rollback_or_fail "Rollback left partial state for '$normalized_team' after storage setup failure"
        release_state_lock
        disable_state_lock_trap
        log_error "Failed to set up storage for '$normalized_team'"
        return 1
    fi

    if ! ensure_bashrc_defaults "$normalized_team"; then
        rollback_or_fail "Rollback left partial state for '$normalized_team' after bashrc setup failure"
        release_state_lock
        disable_state_lock_trap
        log_error "Failed to configure shell defaults for '$normalized_team'"
        return 1
    fi

    if ! save_team_sources "$normalized_team" "$normalized_sources"; then
        rollback_or_fail "Rollback left partial state for '$normalized_team' after metadata persistence failure"
        release_state_lock
        disable_state_lock_trap
        log_error "Failed to persist team sources for '$normalized_team'"
        return 1
    fi

    release_state_lock
    disable_state_lock_trap
    log_success "Team account '$normalized_team' created successfully"
}

cmd_add() {
    local positional=()
    local team_mode=0
    local team_name=""
    local team_sources=""

    if [[ $# -eq 0 ]]; then
        log_error "No usernames provided"
        personal_add_usage
        team_add_usage
        return 1
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --team)
                team_mode=1
                shift
                if [[ $# -eq 0 ]]; then
                    log_error "Missing value for --team"
                    team_add_usage
                    return 1
                fi
                team_name="$1"
                ;;
            --from)
                team_mode=1
                shift
                if [[ $# -eq 0 ]]; then
                    log_error "Missing value for --from"
                    team_add_usage
                    return 1
                fi
                team_sources="$1"
                ;;
            --*)
                log_error "Unknown add option '$1'"
                team_add_usage
                return 1
                ;;
            *)
                positional+=("$1")
                ;;
        esac
        shift
    done

    if [[ $team_mode -eq 1 ]]; then
        if [[ -n "$team_name" && ${#positional[@]} -gt 0 ]]; then
            log_error "Do not mix positional usernames with --team mode"
            team_add_usage
            return 1
        fi

        if [[ -z "$team_name" || -z "$team_sources" ]]; then
            log_error "Both --team and --from are required for team account creation"
            team_add_usage
            return 1
        fi

        add_team_account "$team_name" "$team_sources"
        return
    fi

    add_personal_users "${positional[@]}"
}

remove_team_account() {
    local username="$1"
    local source_csv=""
    local had_system_user=0

    log_info "Removing team account '$username'"

    if ! acquire_state_lock; then
        log_error "Could not acquire state lock"
        return 1
    fi
    enable_state_lock_trap

    if ! source_csv=$(team_sources_for_account "$username"); then
        release_state_lock
        disable_state_lock_trap
        log_error "Team account '$username' is missing metadata in $TEAM_SOURCES_FILE; refusing to remove automatically"
        return 1
    fi

    if [[ -z "$source_csv" ]]; then
        release_state_lock
        disable_state_lock_trap
        log_error "Team account '$username' has invalid empty metadata; refusing to remove automatically"
        return 1
    fi

    if id "$username" &>/dev/null; then
        had_system_user=1
        if ! userdel -r "$username"; then
            release_state_lock
            disable_state_lock_trap
            log_error "Failed to remove team account '$username'"
            return 1
        fi

        cleanup_storage "$username"
    else
        log_warn "Team account '$username' system user is already missing; removing stale metadata only"
    fi

    if ! remove_team_sources "$username"; then
        release_state_lock
        disable_state_lock_trap
        log_error "Removed team account '$username' but failed to remove metadata from $TEAM_SOURCES_FILE"
        return 1
    fi

    release_state_lock
    disable_state_lock_trap
    if [[ $had_system_user -eq 1 ]]; then
        log_success "Team account '$username' removed successfully"
    else
        log_success "Removed stale team metadata for '$username'"
    fi
}

remove_personal_user() {
    local username="$1"

    log_info "Removing user '$username'"
    cleanup_storage "$username"
    userdel -r "$username"
    log_success "User '$username' removed successfully"
}

cmd_remove() {
    local username
    local had_error=0

    if [[ $# -eq 0 ]]; then
        log_error "No usernames provided"
        echo "Usage: lab-manage remove <username> [...]" >&2
        return 1
    fi

    for username in "$@"; do
        if team_account_has_metadata "$username" || (id "$username" &>/dev/null && user_in_group "$username" "$TEAMGROUP"); then
            if ! remove_team_account "$username"; then
                had_error=1
            fi
        elif ! id "$username" &>/dev/null; then
            log_warn "User '$username' does not exist, skipping"
            continue
        elif user_in_group "$username" "$LABGROUP"; then
            if ! remove_personal_user "$username"; then
                had_error=1
            fi
        else
            log_error "User '$username' is not managed by lab-manage, refusing to remove"
            had_error=1
        fi
    done

    return "$had_error"
}

cmd_list() {
    local personal_members
    local team_name
    local source_csv
    local found=0
    local user

    personal_members=$(get_group_members "$LABGROUP")
    if [[ -n "$personal_members" ]]; then
        found=1
        echo "Managed lab users:"
        echo "------------------"
        while IFS= read -r user; do
            [[ -z "$user" ]] && continue
            echo "  - $user"
        done <<< "$(printf '%s' "$personal_members" | tr ',' '\n')"
    fi

    local printed_team_header=0
    ensure_metadata_storage
    while IFS=$'\t' read -r team_name source_csv; do
        [[ -z "${team_name:-}" ]] && continue
        [[ "$team_name" =~ ^# ]] && continue
        if [[ $printed_team_header -eq 0 ]]; then
            if [[ -n "$personal_members" ]]; then
                echo ""
            fi
            echo "Managed team accounts:"
            echo "----------------------"
            printed_team_header=1
            found=1
        fi
        echo "  - ${team_name} (sources: ${source_csv})"
    done < "$TEAM_SOURCES_FILE"

    if [[ $found -eq 0 ]]; then
        log_info "No managed users found"
    fi
}

cmd_refresh_bashrc() {
    local personal_members
    local user
    local team_name
    local source_csv
    local had_error=0
    local refresh_users=()

    if [[ $# -gt 0 ]]; then
        for user in "$@"; do
            append_unique_user "$user"
        done
    else
        personal_members=$(get_group_members "$LABGROUP")
        if [[ -n "$personal_members" ]]; then
            while IFS= read -r user; do
                [[ -z "$user" ]] && continue
                append_unique_user "$user"
            done <<< "$(printf '%s' "$personal_members" | tr ',' '\n')"
        fi

        ensure_metadata_storage
        while IFS=$'\t' read -r team_name source_csv; do
            [[ -z "${team_name:-}" ]] && continue
            [[ "$team_name" =~ ^# ]] && continue
            append_unique_user "$team_name"
        done < "$TEAM_SOURCES_FILE"
    fi

    if [[ ${#refresh_users[@]} -eq 0 ]]; then
        log_info "No managed users found"
        return 0
    fi

    for user in "${refresh_users[@]}"; do
        if ! id "$user" &>/dev/null; then
            log_warn "User '$user' does not exist, skipping"
            had_error=1
            continue
        fi

        if ensure_bashrc_defaults "$user"; then
            log_success "Configured shared bashrc for '$user'"
        else
            log_error "Failed to configure shared bashrc for '$user'"
            had_error=1
        fi
    done

    return "$had_error"
}

sync_personal_user() {
    local username="$1"
    local keys
    local valid_keys
    local write_status

    log_info "Syncing SSH keys for '$username'"

    if keys=$(fetch_github_keys "$username"); then
        if valid_keys=$(validate_ssh_keys "$keys"); then
            set +e
            write_authorized_keys "$username" "$valid_keys"
            write_status=$?
            set -e
            if [[ $write_status -eq 10 ]]; then
                log_info "No key changes for '$username'"
            elif [[ $write_status -eq 0 ]]; then
                log_success "Synced keys for '$username'"
            else
                log_error "Failed to write authorized_keys for '$username'"
                return 1
            fi
            return 0
        fi

        log_warn "No valid SSH keys found for '$username'"
        return 1
    fi

    log_warn "Could not fetch SSH keys for '$username'"
    return 1
}

sync_team_account() {
    local team_name="$1"
    local source_csv="$2"
    local merged_keys
    local write_status

    log_info "Syncing team account '$team_name' from GitHub source users '$source_csv'"

    if ! id "$team_name" &>/dev/null; then
        log_warn "Team account '$team_name' no longer exists"
        return 1
    fi

    if ! merged_keys=$(merge_source_user_keys "$source_csv"); then
        log_warn "No valid GitHub SSH keys found for team account '$team_name'; keeping existing keys"
        return 1
    fi

    set +e
    write_authorized_keys "$team_name" "$merged_keys"
    write_status=$?
    set -e
    if [[ $write_status -eq 10 ]]; then
        log_info "No key changes for team account '$team_name'"
    elif [[ $write_status -eq 0 ]]; then
        log_success "Synced keys for team account '$team_name'"
    else
        log_error "Failed to write authorized_keys for team account '$team_name'"
        return 1
    fi

    return 0
}

cmd_sync() {
    local personal_members
    local user
    local team_name
    local source_csv
    local synced=0
    local failed=0

    if ! acquire_state_lock; then
        log_error "Could not acquire state lock"
        return 1
    fi
    enable_state_lock_trap

    personal_members=$(get_group_members "$LABGROUP")
    if [[ -n "$personal_members" ]]; then
        while IFS= read -r user; do
            [[ -z "$user" ]] && continue
            if sync_personal_user "$user"; then
                ((synced++)) || true
            else
                ((failed++)) || true
            fi
        done <<< "$(printf '%s' "$personal_members" | tr ',' '\n')"
    fi

    ensure_metadata_storage
    while IFS=$'\t' read -r team_name source_csv; do
        [[ -z "${team_name:-}" ]] && continue
        [[ "$team_name" =~ ^# ]] && continue
        if sync_team_account "$team_name" "$source_csv"; then
            ((synced++)) || true
        else
            ((failed++)) || true
        fi
    done < "$TEAM_SOURCES_FILE"

    release_state_lock
    disable_state_lock_trap

    if [[ $synced -eq 0 && $failed -eq 0 ]]; then
        log_info "No managed users to sync"
        return
    fi

    echo ""
    log_info "Sync complete: $synced users synced, $failed failures"
    if [[ $failed -gt 0 ]]; then
        return 1
    fi
}

cmd_update() {
    local team_name=""
    local from_sources=""
    local add_sources=""
    local remove_sources=""
    local normalized_team
    local existing_sources
    local new_sources
    local normalized_list
    local merged_keys
    local mode_count=0
    local write_status
    local source_user
    local existing_user
    local is_member
    local should_remove
    local joined=""
    local idx
    local existing_array=()
    local mode_array=()
    local output_array=()

    if [[ $# -eq 0 ]]; then
        log_error "No update options provided"
        update_usage
        return 1
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --team)
                shift
                if [[ $# -eq 0 ]]; then
                    log_error "Missing value for --team"
                    update_usage
                    return 1
                fi
                team_name="$1"
                ;;
            --from)
                shift
                if [[ $# -eq 0 ]]; then
                    log_error "Missing value for --from"
                    update_usage
                    return 1
                fi
                from_sources="$1"
                ;;
            --add)
                shift
                if [[ $# -eq 0 ]]; then
                    log_error "Missing value for --add"
                    update_usage
                    return 1
                fi
                add_sources="$1"
                ;;
            --remove)
                shift
                if [[ $# -eq 0 ]]; then
                    log_error "Missing value for --remove"
                    update_usage
                    return 1
                fi
                remove_sources="$1"
                ;;
            --*)
                log_error "Unknown update option '$1'"
                update_usage
                return 1
                ;;
            *)
                log_error "Unexpected argument '$1'"
                update_usage
                return 1
                ;;
        esac
        shift
    done

    [[ -n "$from_sources" ]] && ((mode_count++)) || true
    [[ -n "$add_sources" ]] && ((mode_count++)) || true
    [[ -n "$remove_sources" ]] && ((mode_count++)) || true

    if [[ -z "$team_name" ]]; then
        log_error "--team is required"
        update_usage
        return 1
    fi

    if [[ $mode_count -ne 1 ]]; then
        log_error "Exactly one of --from, --add, or --remove is required"
        update_usage
        return 1
    fi

    normalized_team=$(username_normalize "$team_name")
    validate_username "$normalized_team" || return 1

    if ! existing_sources=$(team_sources_for_account "$normalized_team"); then
        log_error "Team account '$normalized_team' not found in metadata"
        return 1
    fi

    if ! team_account_is_system_user "$normalized_team"; then
        log_error "Team account '$normalized_team' metadata exists, but the managed system account is missing"
        return 1
    fi

    IFS=',' read -r -a existing_array <<< "$existing_sources"

    if [[ -n "$from_sources" ]]; then
        new_sources=$(normalize_source_users "$from_sources") || return 1
    elif [[ -n "$add_sources" ]]; then
        normalized_list=$(normalize_source_users "$add_sources") || return 1
        IFS=',' read -r -a mode_array <<< "$normalized_list"
        output_array=("${existing_array[@]}")

        for source_user in "${mode_array[@]}"; do
            is_member=0
            for existing_user in "${existing_array[@]}"; do
                if [[ "$existing_user" == "$source_user" ]]; then
                    is_member=1
                    break
                fi
            done

            if [[ $is_member -eq 1 ]]; then
                log_warn "Source user '$source_user' is already a member of team account '$normalized_team', skipping"
                continue
            fi

            output_array+=("$source_user")
        done

        joined=""
        for idx in "${!output_array[@]}"; do
            [[ $idx -gt 0 ]] && joined+="," 
            joined+="${output_array[$idx]}"
        done
        new_sources="$joined"
    else
        normalized_list=$(normalize_source_users "$remove_sources") || return 1
        IFS=',' read -r -a mode_array <<< "$normalized_list"

        for source_user in "${mode_array[@]}"; do
            is_member=0
            for existing_user in "${existing_array[@]}"; do
                if [[ "$existing_user" == "$source_user" ]]; then
                    is_member=1
                    break
                fi
            done

            if [[ $is_member -eq 0 ]]; then
                log_warn "Source user '$source_user' is not currently a member of team account '$normalized_team', skipping"
            fi
        done

        output_array=()
        for existing_user in "${existing_array[@]}"; do
            should_remove=0
            for source_user in "${mode_array[@]}"; do
                if [[ "$existing_user" == "$source_user" ]]; then
                    should_remove=1
                    break
                fi
            done
            if [[ $should_remove -eq 0 ]]; then
                output_array+=("$existing_user")
            fi
        done

        if [[ ${#output_array[@]} -eq 0 ]]; then
            log_error "Cannot remove all source users from team account '$normalized_team'; at least one must remain"
            return 1
        fi

        joined=""
        for idx in "${!output_array[@]}"; do
            [[ $idx -gt 0 ]] && joined+="," 
            joined+="${output_array[$idx]}"
        done
        new_sources="$joined"
    fi

    if [[ "$new_sources" == "$existing_sources" ]]; then
        log_info "No changes for team account '$normalized_team'"
        return 0
    fi

    validate_team_sources "$normalized_team" "$new_sources" || return 1

    if ! merged_keys=$(merge_source_user_keys "$new_sources"); then
        log_error "No valid GitHub SSH keys available from selected source users for '$normalized_team'"
        return 1
    fi

    if ! acquire_state_lock; then
        log_error "Could not acquire state lock"
        return 1
    fi
    enable_state_lock_trap

    if ! update_team_sources "$normalized_team" "$new_sources"; then
        release_state_lock
        disable_state_lock_trap
        log_error "Failed to update team sources for '$normalized_team'"
        return 1
    fi

    set +e
    write_authorized_keys "$normalized_team" "$merged_keys"
    write_status=$?
    set -e
    if [[ $write_status -ne 0 && $write_status -ne 10 ]]; then
        if ! update_team_sources "$normalized_team" "$existing_sources"; then
            log_error "Failed to roll back team sources for '$normalized_team' after authorized_keys write failure"
        fi
        release_state_lock
        disable_state_lock_trap
        log_error "Failed to write authorized_keys for '$normalized_team'"
        return 1
    fi

    release_state_lock
    disable_state_lock_trap

    log_success "Updated team account '$normalized_team' source users: '$existing_sources' -> '$new_sources'"
}

cmd_help() {
    cat <<EOF
Usage: lab-manage <command> [arguments]

Commands:
  add <username> [...]                    Add lab users (GitHub usernames)
  add --team <account> --from <user1,user2>
                                           Add shared team account from GitHub usernames
  update --team <account> --from <user1,user2>
                                          Replace team source users
  update --team <account> --add <user1,user2>
                                          Add source users to team
  update --team <account> --remove <user1,user2>
                                          Remove source users from team
  remove <username> [...]                 Remove managed lab or team accounts
  list                                    List all managed lab users and team accounts
  refresh-bashrc [username ...]           Add/update shared bashrc loader for managed users
  sync                                    Sync SSH keys for all managed accounts
  help                                    Show this help message

Examples:
  lab-manage add octocat
  lab-manage add student1 student2 student3
  lab-manage add --team projx --from alice,bob
  lab-manage update --team projx --add charlie
  lab-manage update --team projx --remove alice
  lab-manage update --team projx --from alice,charlie
  lab-manage refresh-bashrc
  lab-manage remove student1
  lab-manage list
  lab-manage sync
EOF
}

main() {
    local command="${1:-}"

    case "$command" in
        help|--help|-h|"")
            cmd_help
            [[ -n "$command" ]] || exit 1
            return
            ;;
    esac

    check_root
    shift || true

    case "$command" in
        add)
            ensure_groups
            ensure_shared_dir
            ensure_metadata_storage
            cmd_add "$@"
            ;;
        update)
            ensure_groups
            ensure_shared_dir
            ensure_metadata_storage
            cmd_update "$@"
            ;;
        remove)
            ensure_groups
            ensure_shared_dir
            ensure_metadata_storage
            cmd_remove "$@"
            ;;
        list)
            ensure_groups
            ensure_shared_dir
            ensure_metadata_storage
            cmd_list
            ;;
        refresh-bashrc)
            ensure_groups
            ensure_shared_dir
            ensure_metadata_storage
            cmd_refresh_bashrc "$@"
            ;;
        sync)
            ensure_groups
            ensure_shared_dir
            ensure_metadata_storage
            cmd_sync
            ;;
        *)
            cmd_help
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
